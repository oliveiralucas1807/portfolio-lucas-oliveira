---
import { ui, type Locale } from '@/i18n/config';
const { locale } = Astro.props as { locale: Locale };
const t = ui[locale];
const privacyHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/privacidade/beed-publicacoes/`;
---
<footer class="footer">
  <p>{t.footer}</p>
  <nav aria-label={locale === 'en' ? 'Footer links' : 'Links do rodapé'} style="display:flex;flex-wrap:wrap;gap:.75rem 1.5rem">
    <a href={privacyHref}>{locale === 'en' ? 'Beed app privacy (PT-BR)' : 'Privacidade — Beed Publicações'}</a>
    <a href="#top">{t.backTop} ↑</a>
  </nav>
</footer>
