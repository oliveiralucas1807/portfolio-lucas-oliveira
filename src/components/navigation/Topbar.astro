---
import ThemeControl from '@/components/islands/ThemeControl';
import { localeMeta, ui, type Locale } from '@/i18n/config';
import { siteConfig } from '@/data/site';
import Icon from '@/components/ui/Icon.astro';
const { locale } = Astro.props as { locale: Locale };
const t = ui[locale];
const other = locale === 'pt' ? 'en' : 'pt';
const onBlog = Astro.url.pathname.includes('/blog');
const homeLink = localeMeta[locale].home;
---
<header class="topbar-wrap">
  <nav class="topbar" aria-label={locale === 'pt' ? 'Navegação principal' : 'Primary navigation'}>
    <a class="brand" data-parallax href={homeLink} aria-label="LOS, Lucas Oliveira da Silva, home">LOS<span>®</span></a>
    <div class="topbar-links">
      <a data-parallax href={`${homeLink}#trabalhos`}>{t.work}</a>
      <a data-parallax href={`${homeLink}#sobre`}>{t.about}</a>
      <a class="blog-link" data-parallax href={localeMeta[locale].blog}>{t.blog}</a>
    </div>
    <div class="topbar-actions">
      {siteConfig.linkedin && <a class="icon-button" data-parallax href={siteConfig.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn">in</a>}
      <a class="locale-chip" data-parallax href={onBlog ? localeMeta[other].blog : localeMeta[other].home} aria-label={locale === 'pt' ? 'Ver em inglês, Estados Unidos e Reino Unido' : 'View in Portuguese'} title={locale === 'pt' ? 'English, US and UK' : 'Português'}><Icon name="language" size={19} /></a>
      <ThemeControl client:load label={t.theme} />
    </div>
  </nav>
</header>
