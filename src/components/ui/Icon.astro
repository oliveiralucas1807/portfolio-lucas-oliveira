---
type IconName = 'mail' | 'whatsapp' | 'linkedin' | 'file' | 'arrow' | 'close' | 'play' | 'volume' | 'spark' | 'design' | 'campaign' | 'direction' | 'prompt' | 'automation' | 'mailSolid' | 'whatsappSolid' | 'linkedinSolid' | 'fileSolid' | 'language';
const { name, size = 20, label } = Astro.props as { name: IconName; size?: number; label?: string };
const isLucasEmail = name === 'mail' || name === 'mailSolid';
const isLucasWhatsapp = name === 'whatsapp' || name === 'whatsappSolid';
const solid = isLucasWhatsapp || (!isLucasEmail && name.endsWith('Solid')) || ['design', 'campaign', 'direction', 'prompt', 'automation'].includes(name);
const viewBox = isLucasEmail ? '0 0 512 512' : '0 0 24 24';
const iconSource = isLucasEmail ? 'lucas-email' : isLucasWhatsapp ? 'lucas-whatsapp' : undefined;
