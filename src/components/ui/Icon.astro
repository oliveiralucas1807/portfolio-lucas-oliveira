---
type IconName = 'mail' | 'whatsapp' | 'linkedin' | 'file' | 'arrow' | 'close' | 'play' | 'volume' | 'spark' | 'design' | 'campaign' | 'direction' | 'prompt' | 'automation' | 'mailSolid' | 'whatsappSolid' | 'linkedinSolid' | 'fileSolid' | 'language';
const { name, size = 20, label } = Astro.props as { name: IconName; size?: number; label?: string };
const solid = name.endsWith('Solid') || ['design', 'campaign', 'direction', 'prompt', 'automation'].includes(name);
---
<svg class="ui-icon" width={size} height={size} viewBox="0 0 24 24" fill={solid ? 'currentColor' : 'none'} stroke={solid ? 'none' : 'currentColor'} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden={label ? undefined : 'true'} aria-label={label} role={label ? 'img' : undefined}>
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></>}
  {name === 'whatsapp' && <><path d="M20.5 11.6a8.5 8.5 0 0 1-12.6 7.5L3 20.5l1.4-4.7A8.5 8.5 0 1 1 20.5 11.6Z"/><path d="M8.2 7.7c.3-.6.7-.6 1-.1l1 1.8c.2.4 0 .7-.3 1-.3.3-.6.6.1 1.5.7.9 1.5 1.6 2.5 2 .6.2.9 0 1.2-.4l.7-.9c.3-.4.7-.4 1.1-.2l1.8.9c.5.3.6.7.4 1.2-.4 1-1.5 1.7-2.6 1.7-2.2 0-5-1.8-6.7-4.1-1.2-1.7-1.5-3.2-.2-4.4Z"/></>}
  {name === 'linkedin' && <><rect x="4" y="9" width="3" height="11"/><path d="M5.5 4.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3ZM11 20V9h3v1.7c.8-1.3 2-2 3.6-2 2.7 0 3.4 1.8 3.4 4.6V20h-3v-6c0-1.5-.3-2.7-1.9-2.7-1.7 0-2.1 1.3-2.1 3V20h-3Z"/></>}
  {name === 'file' && <><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v5h5M8.5 15h7M8.5 18h5"/></>}
  {name === 'arrow' && <><path d="M5 19 19 5M9 5h10v10"/></>}
  {name === 'close' && <path d="m6 6 12 12M18 6 6 18"/>}
  {name === 'play' && <path d="m9 6 9 6-9 6z"/>}
  {name === 'volume' && <><path d="M5 10v4h3l4 3V7l-4 3zM16 9c1 1 1 5 0 6M19 7c2 2 2 8 0 10"/></>}
  {name === 'spark' && <><path d="m12 3 1.4 4.6L18 9l-4.6 1.4L12 15l-1.4-4.6L6 9l4.6-1.4zM18 15l.8 2.2L21 18l-2.2.8L18 21l-.8-2.2L15 18l2.2-.8z"/></>}
  {name === 'design' && <path d="M4 4h16v12H4zM7 19h10v2H7zM7 7h5v2H7zm0 4h10v2H7z"/>}
  {name === 'campaign' && <path d="M3 10v4h3l6 4V6L6 10H3zm11-2.5v9l2.5 1.5V6L14 7.5zm4.5 1v7H21v-7h-2.5z"/>}
  {name === 'direction' && <path d="m12 2 3 7 7 3-7 3-3 7-3-7-7-3 7-3 3-7zm0 6.2L10.8 11 8 12l2.8 1 1.2 2.8 1.2-2.8 2.8-1-2.8-1L12 8.2z"/>}
  {name === 'prompt' && <path d="M4 4h16v13H9l-5 4V4zm4 4v2h8V8H8zm0 4v2h5v-2H8z"/>}
  {name === 'automation' && <path d="M10 2h4l.7 2.3 2 .8 2.1-1.1 2.2 2.8-1.5 1.8.3 2.2 2.2 1.2-1 3.4-2.5.1-1.3 1.8.5 2.3-3.1 1.8-1.5-1.9-2.2.2L14 22h-4l-.7-2.3-2-.8-2.1 1.1L3 17.2l1.5-1.8-.3-2.2L2 12l1-3.4 2.5-.1 1.3-1.8-.5-2.3 3.1-1.8L10 4V2zm2 6a4 4 0 1 0 0 8 4 4 0 0 0 0-8z"/>}
  {name === 'mailSolid' && <path d="M3 5h18v14H3V5zm1.5 2L12 12.2 19.5 7H4.5z"/>}
  {name === 'whatsappSolid' && <path d="M12 2a9.7 9.7 0 0 0-8.4 14.6L2 22l5.6-1.5A9.8 9.8 0 1 0 12 2zm4.9 13.8c-.2.7-1.4 1.3-2 1.4-.5.1-1.2.1-2-.2-3.5-1.2-5.8-4.8-6-5-.2-.3-1.4-1.9-1.4-3.6 0-1.7.9-2.6 1.2-3 .3-.3.7-.4 1-.4h.7c.2 0 .5-.1.8.6l1.1 2.7c.1.2.1.5 0 .7l-.5.8-.7.8c-.2.2-.4.5-.2.9.3.5 1.1 1.8 2.4 2.9 1.6 1.4 3 1.8 3.4 2 .4.1.6.1.9-.2l1.2-1.4c.3-.3.5-.3.9-.2l2.5 1.2c.4.2.7.3.8.5.1.1.1.7-.1 1.4z"/>}
  {name === 'linkedinSolid' && <path d="M4 3.5A2.5 2.5 0 1 1 4 8.5a2.5 2.5 0 0 1 0-5zM2 10h4v12H2V10zm6.5 0h3.8v1.7h.1c.5-1 1.8-2.1 3.8-2.1 4 0 4.8 2.7 4.8 6.1V22h-4v-5.6c0-1.3 0-3.1-1.9-3.1s-2.2 1.5-2.2 3V22h-4V10z"/>}
  {name === 'fileSolid' && <path d="M5 2h9l5 5v15H5V2zm9 1.5V8h4.5L14 3.5zM8 12v2h8v-2H8zm0 4v2h6v-2H8z"/>}
  {name === 'language' && <><path d="M3 6h8v12H3zM5 9h4M5 12h4M5 15h4"/><path d="M13 6h8v12h-8zM13 6l8 12M21 6l-8 12M17 6v12M13 12h8"/></>}
