---
type IconName = 'mail' | 'whatsapp' | 'linkedin' | 'file' | 'arrow' | 'close' | 'play' | 'volume' | 'spark';
const { name, size = 20, label } = Astro.props as { name: IconName; size?: number; label?: string };
---
<svg class="ui-icon" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden={label ? undefined : 'true'} aria-label={label} role={label ? 'img' : undefined}>
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></>}
  {name === 'whatsapp' && <><path d="M20.5 11.6a8.5 8.5 0 0 1-12.6 7.5L3 20.5l1.4-4.7A8.5 8.5 0 1 1 20.5 11.6Z"/><path d="M8.2 7.7c.3-.6.7-.6 1-.1l1 1.8c.2.4 0 .7-.3 1-.3.3-.6.6.1 1.5.7.9 1.5 1.6 2.5 2 .6.2.9 0 1.2-.4l.7-.9c.3-.4.7-.4 1.1-.2l1.8.9c.5.3.6.7.4 1.2-.4 1-1.5 1.7-2.6 1.7-2.2 0-5-1.8-6.7-4.1-1.2-1.7-1.5-3.2-.2-4.4Z"/></>}
  {name === 'linkedin' && <><rect x="4" y="9" width="3" height="11"/><path d="M5.5 4.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3ZM11 20V9h3v1.7c.8-1.3 2-2 3.6-2 2.7 0 3.4 1.8 3.4 4.6V20h-3v-6c0-1.5-.3-2.7-1.9-2.7-1.7 0-2.1 1.3-2.1 3V20h-3Z"/></>}
  {name === 'file' && <><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v5h5M8.5 15h7M8.5 18h5"/></>}
  {name === 'arrow' && <><path d="M5 19 19 5M9 5h10v10"/></>}
  {name === 'close' && <path d="m6 6 12 12M18 6 6 18"/>}
  {name === 'play' && <path d="m9 6 9 6-9 6z"/>}
  {name === 'volume' && <><path d="M5 10v4h3l4 3V7l-4 3zM16 9c1 1 1 5 0 6M19 7c2 2 2 8 0 10"/></>}
  {name === 'spark' && <><path d="m12 3 1.4 4.6L18 9l-4.6 1.4L12 15l-1.4-4.6L6 9l4.6-1.4zM18 15l.8 2.2L21 18l-2.2.8L18 21l-.8-2.2L15 18l2.2-.8z"/></>}
</svg>
