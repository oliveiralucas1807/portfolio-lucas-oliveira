---
import PortfolioModal from '@/components/islands/PortfolioModal';
import { siteConfig } from '@/data/site';
import { ui, type Locale } from '@/i18n/config';
const { locale } = Astro.props as { locale: Locale };
const t = ui[locale];
const contactLinks: Array<{ href: string; label: string; detail: string; external?: boolean; icon: 'mail' | 'whatsapp' | 'linkedin' | 'file' }> = [
  { href: `mailto:${siteConfig.email}`, label: t.email, detail: siteConfig.email, icon: 'mail' },
  { href: siteConfig.whatsapp, label: t.whatsapp, detail: '+55 92 98848-4334', external: true, icon: 'whatsapp' },
  { href: siteConfig.linkedin, label: t.linkedin, detail: 'LinkedIn', external: true, icon: 'linkedin' },
  { href: siteConfig.resume[locale], label: t.resume, detail: 'HTML + PDF', external: true, icon: 'file' },
];
---
<PortfolioModal
  client:load
  contactTitle={locale === 'pt' ? 'Opções de contato' : 'Contact options'}
  contactIntro={locale === 'pt' ? 'Escolha o canal mais conveniente para conversar sobre trabalho, campanhas ou projetos.' : 'Choose the best channel to discuss work, campaigns or projects.'}
  contactLinks={contactLinks}
  closeLabel={locale === 'pt' ? 'Fechar janela' : 'Close window'}
/>
