---
import { cases } from '@/data/cases';
import { ui, type Locale } from '@/i18n/config';
const { locale } = Astro.props as { locale: Locale };
const t = ui[locale];
---
<section class="projects section-shell" id="trabalhos" aria-labelledby="projects-title">
  <div class="section-intro projects-intro" data-reveal>
    <p class="eyebrow">{t.projectsEyebrow}</p>
    <h2 id="projects-title">{t.projectsTitle}</h2>
  </div>
  <div class="project-list">
    {cases.map((item, index) => (
      <article class:list={['project', `project-${item.id}`]} id={item.id} data-reveal>
        <div class="project-meta"><span>{String(index + 1).padStart(2, '0')}</span><span>{item.client}</span><span>{locale === 'pt' ? `Amostra de materiais de ${item.period.toLocaleLowerCase()}` : `Material sample from ${item.period}`}</span></div>
        <div class="project-heading"><h3>{item.id === 'coimbra' && locale === 'pt' ? <><span class="title-line">Campanhas promocionais</span><span class="title-line">para varejo técnico</span></> : item.copy.title[locale]}</h3></div>
        <p class="project-context">{item.copy.summary[locale]}</p>
        <div class="project-details">
          <div><strong>{t.roleLabel}</strong><p>{item.copy.role[locale]}</p></div>
          <div><strong>{t.deliveries}</strong><p>{item.deliveriesLocalized[locale].slice(0, 4).join(' · ')}</p></div>
          <div><strong>{locale === 'pt' ? 'Direção aplicada' : 'Applied direction'}</strong><p>{item.copy.solution[locale]}</p></div>
        </div>
        <div class="project-featured">{item.featured.map((image) => { const imageIndex = item.images.findIndex((candidate) => candidate.src === image.src); const alt = locale === 'pt' ? `${item.client}: ${image.alt}` : `${item.client} campaign artwork`; return <button class="project-image-trigger" type="button" data-lightbox-id={`${item.id}:${imageIndex}`} aria-label={`${locale === 'pt' ? 'Ampliar' : 'Enlarge'}: ${alt}`}><img data-parallax src={image.src} alt={alt} loading="lazy" /></button>; })}</div>
        <details class="project-more">
          <summary><span class="project-expand-cta">{t.openCase}<b>＋</b></span></summary>
          <p>{item.copy.result[locale]}</p>
          <div class="project-gallery">{item.images.slice(1).map((image, imageIndex) => { const alt = locale === 'pt' ? `${item.client}: ${image.alt}` : `${item.client} campaign artwork`; return <button class="project-image-trigger" style={`--gallery-index:${imageIndex}`} type="button" data-lightbox-id={`${item.id}:${imageIndex + 1}`} aria-label={`${locale === 'pt' ? 'Ampliar' : 'Enlarge'}: ${alt}`}><img src={image.src} alt={alt} loading="lazy" /></button>; })}<div class="project-gallery-more" style="--gallery-index:19"><span>LOS®</span><div><b>+</b><strong>{locale === 'pt' ? 'Diversos outros cards e materiais produzidos' : 'Many other cards and materials produced'}</strong></div></div></div>
        </details>
      </article>
    ))}
    <article class="future-card"><p>07+</p><h3>{t.more}</h3></article>
  </div>
  <aside class="deep-bridge">
    <p class="eyebrow">Processo / Desenvolvimento</p><div class="deep-bridge-grid"><h3>{t.deepTitle}</h3><div><p>{t.deepText}</p><div class="deep-action"><button type="button" disabled>{t.deepAction} ↗</button><span>{locale === 'pt' ? 'Indisponível no momento' : 'Currently unavailable'}</span></div></div></div>
  </aside>
</section>
