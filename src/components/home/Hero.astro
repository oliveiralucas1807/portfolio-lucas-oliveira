---
import { localeMeta, ui, type Locale } from '@/i18n/config';
import { siteConfig } from '@/data/site';
const { locale } = Astro.props as { locale: Locale };
const t = ui[locale];
---
<section class="hero" aria-labelledby="hero-title">
  <picture class="hero-art">
    <source media="(max-width: 700px)" srcset="/assets/hero/foto-lucas-mobile-sem-texto.webp" type="image/webp" />
    <img src="/assets/hero/foto-lucas-desktop.webp" alt="Lucas Oliveira, Designer Gráfico Pleno" fetchpriority="high" />
  </picture>
  <div class="hero-overlay"></div>
  <div class="hero-copy">
    <p class="hero-kicker">{locale === 'pt' ? 'Manaus · Brasil · Desde 2019' : 'Manaus · Brazil · Since 2019'}</p>
    <h1 id="hero-title">Lucas Oliveira<br /><span>{t.role}</span></h1>
    <p class="hero-intro">{t.heroIntro}</p>
    <div class="hero-actions">
      <a class="button button-accent" data-parallax href="#trabalhos">{t.seeWork} ↘</a>
      <a class="button" data-parallax href={siteConfig.resume[locale]} target="_blank" rel="noreferrer">{t.resume}</a>
      <button class="button button-ghost" data-parallax type="button" data-modal-open="contact">{t.talk}</button>
    </div>
    <a class="language-call" data-parallax href={localeMeta[locale === 'pt' ? 'en' : 'pt'].home}>{t.language} →</a>
  </div>
</section>
