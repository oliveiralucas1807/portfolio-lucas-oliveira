---
import { localeMeta, ui, type Locale } from '@/i18n/config';
import { siteConfig } from '@/data/site';
const { locale } = Astro.props as { locale: Locale };
const t = ui[locale];
---
<section class="hero" aria-labelledby="hero-title">
  <picture class="hero-art">
    <source media="(max-width: 700px)" srcset="/assets/hero/foto-lucas-mobile-v2-original.png" />
    <img src="/assets/hero/foto-lucas-desktop-original.png" alt="Lucas Oliveira, Designer Gráfico Pleno" fetchpriority="high" />
  </picture>
  <div class="hero-overlay"></div>
  <div class="hero-copy">
    <p class="hero-kicker">Manaus · Brasil · 2019—2026</p>
    <h1 id="hero-title">Lucas Oliveira<br /><span>{t.role}</span></h1>
    <p class="hero-intro">{t.heroIntro}</p>
    <div class="hero-actions">
      <a class="button button-accent" href="#trabalhos">{t.seeWork} ↘</a>
      <a class="button" href={siteConfig.resume[locale]} target="_blank" rel="noreferrer">{t.resume}</a>
      <a class="button button-ghost" href="#contato">{t.talk}</a>
    </div>
    <a class="language-call" href={localeMeta[locale === 'pt' ? 'en' : 'pt'].home}>{t.language} →</a>
  </div>
</section>
