---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import KineticGallery from '@/components/home/KineticGallery.astro';
import Projects from '@/components/home/Projects.astro';
import AboutContact from '@/components/home/AboutContact.astro';
import ModalLayer from '@/components/home/ModalLayer.astro';
import CaseLightbox from '@/components/islands/CaseLightbox';
import { cases } from '@/data/cases';
const lightboxImages = cases.flatMap((item) => item.images.map((image, index) => ({ id: `${item.id}:${index}`, group: item.id, src: image.src, alt: `${item.client}: ${image.alt}`, client: item.client })));
---
<BaseLayout locale="pt" title="Lucas Oliveira | Designer Gráfico Pleno" description="Design gráfico, campanhas digitais e IA aplicada ao design.">
  <Hero locale="pt" /><KineticGallery locale="pt" /><Projects locale="pt" /><AboutContact locale="pt" /><ModalLayer locale="pt" /><CaseLightbox client:load locale="pt" images={lightboxImages} />
</BaseLayout>
