---
import '@/styles/global.css';
import Topbar from '@/components/navigation/Topbar.astro';
import Footer from '@/components/navigation/Footer.astro';
import CustomCursor from '@/components/islands/CustomCursor';
import MotionLayer from '@/components/islands/MotionLayer';
import { localeMeta, ui, type Locale } from '@/i18n/config';
import { sitePath } from '@/utils/paths';
const { locale, title, description } = Astro.props as { locale: Locale; title: string; description: string };
const route = Astro.url.pathname;
const onBlog = route.includes('/blog');
const ptPath = onBlog ? localeMeta.pt.blog : localeMeta.pt.home;
const enPath = onBlog ? localeMeta.en.blog : localeMeta.en.home;
const siteOrigin = Astro.site ?? new URL('https://oliveiralucas1807.github.io');
---
<!doctype html>
<html lang={localeMeta[locale].lang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={import.meta.env.PUBLIC_SITE_STAGE === 'production' ? 'index,follow' : 'noindex,nofollow'} />
    <link rel="icon" href={sitePath('/favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={new URL(locale === 'pt' ? ptPath : enPath, siteOrigin)} />
    <link rel="alternate" hreflang="pt-BR" href={new URL(ptPath, siteOrigin)} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, siteOrigin)} />
    <link rel="alternate" hreflang="x-default" href={new URL(ptPath, siteOrigin)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('portfolio-theme');
        const dark = saved === 'dark' || (!saved && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body id="top">
    <a class="skip-link" href="#conteudo">{ui[locale].skip}</a>
    <Topbar locale={locale} />
    <CustomCursor client:load />
    <MotionLayer client:load />
    <main id="conteudo"><slot /></main>
    <Footer locale={locale} />
  </body>
</html>
